{
  // Configuración de despliegue de Cloudflare Workers (assets estáticos).
  // Solo se sirve el contenido de ./public; el resto del repo (privado) no se publica.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "horizonte-emirates-web",
  "compatibility_date": "2026-06-06",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // "none": sirve las páginas .html tal cual, sin redirección 307 a URL sin extensión.
    // Mantiene coherencia con los canonical, el sitemap.xml y el enlazado interno (todos en .html).
    "html_handling": "none",
    // Rutas no encontradas → sirve la 404.html de marca con estado 404.
    "not_found_handling": "404-page",
    // El router de Assets aplica 301 de / → /index.html con precedencia sobre _redirects.
    // El worker intercepta solo "/" y sirve index.html con 200 (A06/M31).
    "run_worker_first": true
  }
}
