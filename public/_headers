# Cabeceras de seguridad: FUENTE DE VERDAD (Cloudflare Workers Assets)
#
# ✅ Cloudflare Pages SÍ procesa este archivo de forma nativa: estas cabeceras se aplican por HTTP.
#    Este es el directorio de salida (public/), así que /* cubre todo el sitio.
#    Al estar activas aquí, ELIMINAR la antigua Transform Rule de Cloudflare (evita cabeceras duplicadas).
#    Tras validar que la CSP llega por HTTP, se puede retirar el <meta> CSP de las 3 páginas
#    (fuente única). Ver docs/SEGURIDAD_CABECERAS.md.
#
# Cache de assets (F1). Imagenes, fuentes y logos: inmutables (solo cambian al renombrarse).
# CSS/JS con TTL menor + revalidacion en segundo plano hasta tener fingerprint (F12).
# Las reglas /* de seguridad se aplican de forma acumulativa (cabeceras distintas).
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/projects/*
  Cache-Control: public, max-age=31536000, immutable

/assets/blog/*
  Cache-Control: public, max-age=31536000, immutable

/assets/logos/*
  Cache-Control: public, max-age=31536000, immutable

/assets/og/*
  Cache-Control: public, max-age=2592000

/assets/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/guias/*.pdf
  Cache-Control: public, max-age=604800

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://www.googleadservices.com https://connect.facebook.net; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://api.web3forms.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://www.google.com https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com https://www.googleadservices.com https://www.facebook.com https://connect.facebook.net; frame-src https://www.googletagmanager.com https://calendly.com https://td.doubleclick.net; frame-ancestors 'none'; form-action 'self' https://api.web3forms.com; upgrade-insecure-requests
